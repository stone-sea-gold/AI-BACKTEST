# aiquant 配置

# 数据目录
AIQUANT_DATA_DIR=./workspace

# DuckDB 数据库路径
AIQUANT_DUCKDB_PATH=./workspace/aiquant.duckdb

# SQLite 数据库路径
AIQUANT_SQLITE_PATH=./workspace/aiquant.db

# 日志级别: DEBUG, INFO, WARNING, ERROR
AIQUANT_LOG_LEVEL=INFO

# 无风险利率 (用于夏普比率计算)
AIQUANT_RISK_FREE_RATE=0.025

# 佣金费率 (万2.5)
AIQUANT_COMMISSION_RATE=0.00025

# 最低佣金 (元)
AIQUANT_MIN_COMMISSION=5.0

# 印花税率 (千1, 仅卖出)
AIQUANT_STAMP_TAX_RATE=0.001

# 过户费率 (万0.2)
AIQUANT_TRANSFER_FEE_RATE=0.00002

# 红利税率
AIQUANT_DIVIDEND_TAX_RATE=0.10
